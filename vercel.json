{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "client",
      "framework": "vite",
      "installCommand": "cd .. && npm ci --include=dev",
      "buildCommand": "cd .. && npm run frontend",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": ".",
      "entrypoint": "api/proxy.js",
      "framework": "express",
      "installCommand": "npm ci --include=dev",
      "buildCommand": "npm run build:data-provider && npm run build:data-schemas && npm run build:api && node scripts/verify-coderax-deployment.mjs --repo-only && node --test scripts/verify-coderax-deployment.test.mjs packages/api/proxy.test.mjs scripts/verify-oci-deployment.test.mjs",
      "functions": {
        "api/proxy.js": {
          "includeFiles": "{api/proxy.js,packages/api/dist/proxy.cjs,packages/api/dist/rolldown-runtime-*.cjs}",
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/oauth/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/livez",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/readyz",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
