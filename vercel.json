{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "client",
      "framework": "vite",
      "installCommand": "cd .. && npm ci --include=dev --workspaces --include-workspace-root",
      "buildCommand": "cd .. && npm run frontend",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": ".",
      "entrypoint": "api/server/index.js",
      "framework": "express",
      "installCommand": "npm ci --include=dev --workspaces --include-workspace-root",
      "buildCommand": "node scripts/verify-coderax-deployment.mjs --repo-only && node --test scripts/verify-coderax-deployment.test.mjs && npm run build:data-provider && npm run build:data-schemas && npm run build:api && node scripts/verify-coderax-api-bundle.mjs && node --test scripts/verify-coderax-optional-redis.test.mjs && npm run build:client-package && npm run build:client"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/oauth/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/livez",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/readyz",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
