{
  // Cloudflare Workers Builds deploys this service as static assets only: the
  // React app is built into client/dist by `npm run build:worker`, and every
  // unmatched navigation falls back to index.html for client-side routing.
  "name": "coderax",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./client/dist",
    "not_found_handling": "single-page-application"
  }
}
