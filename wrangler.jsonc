{
  // Cloudflare Workers Builds deploys the built client as static assets, plus a
  // thin edge router for the API paths. `npm run frontend` produces client/dist
  // before `wrangler deploy` runs, and client-side routes fall back to
  // index.html. API paths run the Worker first so they are forwarded to the
  // configured backend instead of being answered with index.html.
  //
  // The public production host is https://coderax.nnabdelshahid.workers.dev.
  // CODERAX_API_ORIGIN is a non-secret Worker variable and must name the
  // authorized OCI origin; CODERAX_PROXY_SECRET is a Worker secret and must
  // never be committed. See deploy/cloudflare/README.md.
  "name": "coderax",
  "workers_dev": true,
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-11-25",
  // `wrangler deploy` deletes plain-text vars that are not in this file, so a
  // dashboard-set CODERAX_API_ORIGIN would disappear on the next Workers Builds
  // run and every API route would answer 503 again. Secrets are never deleted
  // by a deploy, so CODERAX_PROXY_SECRET survives either way.
  "keep_vars": true,
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/oauth", "/oauth/*", "/health", "/livez", "/readyz"],
  },
  "previews": {},
}
