#!/bin/sh
# Pre-push guard: refuse pushes that update a protected branch.
#
# Canonical copy: ~/git-hooks/pre-push
# Installed into: <repo>/.git/hooks/pre-push, or <repo>/.husky/pre-push in husky repos.
# Policy: ~/AGENTS.md (sections 1-8) -- never push to main, master or dev; always raise a PR.
#
# Deliberate one-off override (user approved this exact push, nothing else):
#   ALLOW_PROTECTED_PUSH=1 git push origin HEAD:main
#
# POSIX sh on purpose: husky's dispatcher (`.husky/_/h`) sources hooks with `sh`, so the
# same file has to work both as a git hook and as a husky hook.
set -u

PROTECTED="main master dev"

# Buffer stdin to a file first: a chained local hook needs the same ref list we do.
if refs=$(mktemp 2>/dev/null); then
  :
else
  rc=$?
  [ -z "$refs" ] || rm -f "$refs"
  exit "$rc"
fi
if cat > "$refs"; then
  :
else
  rc=$?
  rm -f "$refs"
  exit "$rc"
fi

here=$(cd "$(dirname "$0")" && pwd)

# Preserve any pre-existing hook: at install time it is moved to pre-push.local.
if [ -x "$here/pre-push.local" ]; then
  if "$here/pre-push.local" "$@" < "$refs"; then
    :
  else
    rc=$?
    rm -f "$refs"
    exit "$rc"
  fi
fi

if [ "${ALLOW_PROTECTED_PUSH:-0}" = "1" ]; then
  echo "pre-push-guard: ALLOW_PROTECTED_PUSH=1 -- allowing this push, branch policy waived for this command only." >&2
  rm -f "$refs"
  exit 0
fi

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  branch=${remote_ref#refs/heads/}
  for protected in $PROTECTED; do
    if [ "$branch" = "$protected" ]; then
      echo "pre-push-guard: REFUSED -- push would update protected branch '$branch'." >&2
      echo "  Work on a topic branch and open a pull request instead (see AGENTS.md, sections 1-8)." >&2
      blocked=1
    fi
  done
done < "$refs"

rm -f "$refs"

if [ "$blocked" -ne 0 ]; then
  echo "pre-push-guard: nothing was pushed. If the user explicitly approved this exact push, re-run with ALLOW_PROTECTED_PUSH=1." >&2
  exit 1
fi

exit 0
