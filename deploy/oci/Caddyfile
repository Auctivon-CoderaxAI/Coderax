# The public listener exists only for the authenticated Vercel API proxy.
# The Ollama port and the Coderax application port are never published.
{$CODERAX_API_HOST} {
	encode zstd gzip

	# route preserves this order: direct Work streams must be handled before the
	# proxy-secret response, while every other path stays proxy-only.
	route {
		# OpenCode Work starts and resumable stream attachments outlive Vercel
		# Hobby's 60-second function limit. Only these prefixes are accepted
		# directly; the app still requires an owner JWT.
		@direct_work {
			path /api/work/chat
			path /api/work/chat/*
			path /api/agents/chat/stream
			path /api/agents/chat/stream/*
			not header X-Coderax-Proxy-Secret {$CODERAX_PROXY_SECRET}
		}
		handle @direct_work {
			reverse_proxy app:3080 {
				flush_interval -1
				header_up Host coderaxai.vercel.app
				header_up X-Forwarded-Host coderaxai.vercel.app
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-For {http.request.remote.host}
				header_up -X-Coderax-Proxy-Secret
			}
		}

		@unauthorized {
			not header X-Coderax-Proxy-Secret {$CODERAX_PROXY_SECRET}
			not path /api/work/chat
			not path /api/work/chat/*
		}
		respond @unauthorized 403

		reverse_proxy app:3080 {
			flush_interval -1
			header_up Host {http.request.header.X-Forwarded-Host}
			header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up -X-Coderax-Proxy-Secret
		}
	}
}
